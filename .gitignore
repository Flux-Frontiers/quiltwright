# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Rendered output.  The stills (~14 MB) are committed: they are the diffable
# reference for what each scene looks like, and regenerating them needs a
# POV-Ray install and patience.  Quilts (25-40 MB each) are release assets,
# rendered by .github/workflows/release.yml; views/ is local scratch.
renders/*
!renders/README.md
!renders/stills/
# Quilts are never committed -- one 16" landscape quilt is 25-40 MB.  These
# two patterns have no slash, so git applies them at every depth: a quilt is
# ignored wherever it is written, not just under renders/.  Overriding that
# needs an explicit negation, which is deliberate.
*_qs[0-9]*x[0-9]*a*.png
*_qs[0-9]*x[0-9]*a*.mp4
pov-scenes/**/*.png

# OS
.DS_Store

# Cruft
*.o

